# Referencia de variables de entorno.
# La app carga los archivos reales desde la carpeta envs/.
# Copia una de las plantillas siguientes:
#   envs/groq.env.example   -> envs/groq.env
#   envs/gemini.env.example -> envs/gemini.env

# Proveedor activo: groq o gemini
LLM_PROVIDER=groq

# Groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL_NAME=openai/gpt-oss-120b

# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL_NAME=gemini-2.0-flash-001
